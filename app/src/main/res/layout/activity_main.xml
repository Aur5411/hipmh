<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_horizontal"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!--
      ★ v1.10.0：独立的「阅读器窗口」（第二个 WebView，悬浮在主 WebView 之上）。
      用户明确要求：点进漫画开始阅读时，相当于「新开一个浏览器窗口」，
      之后的上一章 / 下一章都在这个窗口里完成，返回 = 关闭这个窗口。

      为什么要这么改（v1.9.3 的两个遗留问题都源于此）：
        站点跳转链路是  详情页 → 中间跳转页(m.hipmh.com/chapter/go?...)
                              → 真正的阅读器(reader.hipmh.top/chapter/<b64>)
        如果始终用**同一个** WebView，这条链路会整体压进同一个历史栈：
          ① 从阅读页 loadUrl(详情页) 不是「回退」而是「新开一格」，
             所以再按一次返回，goBack() 就退到了历史里的**阅读页**那一格
             —— 表现就是「返回详情页后，再返回又是漫画阅读页」。
          ② 为了绕开 ①，返回逻辑只能不停 loadUrl，主历史栈永远理不清。

        改成独立的 rdWeb 之后：
          主 WebView 停在详情页**原地不动**（历史栈干净），
          阅读器的一切（含上下章）都发生在 rdWeb 内部，
          「返回」= 隐藏 rdWeb → 原地露出详情页；再返回 = 主 WebView 自己的历史 → 首页。
      本质上这就是用户说的「新开一个窗口、返回即关窗」。
    -->
    <WebView
        android:id="@+id/rdWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/net_error"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/net_error_desc"
            android:textColor="@color/text2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:text="@string/retry"
            android:textColor="#FF0F1115" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnTop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/nav_home"
        android:src="@drawable/ic_back"
        android:tint="@color/text"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnFab"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/nav_menu"
        android:src="@drawable/ic_menu"
        android:tint="@color/text"
        android:visibility="visible" />

</FrameLayout>
