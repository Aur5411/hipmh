<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v1.9：修正布局。
  以前 ListView 与 empty 都带 layout_weight=1 同时存在于垂直 LinearLayout 里：
  列表非空时 empty 虽然 GONE，但仍会因两次 weight 分配把列表高度算错，
  表现为「上半部分一片空白」。现在把两者放进同一个 FrameLayout 里互斥显示。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:gravity="center"
        android:text="@string/title_shelf"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/shelf_empty"
            android:textColor="@color/text2"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp"
            android:gravity="center_horizontal"
            android:text="@string/shelf_empty_hint"
            android:textColor="@color/text2"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:text="@string/shelf_clear"
        android:textColor="@color/danger"
        android:textSize="14sp" />

</LinearLayout>
